# Clé gratuite : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# SteamID64 (17 chiffres), pseudo d'URL personnalisée, ou URL complète du profil
STEAM_ID=

# Facultatif : durées « pour finir » via IGDB (Twitch). Crée une application sur https://dev.twitch.tv/console/apps
# (catégorie « Application Integration », URL de redirection http://localhost), puis copie son Client ID et un secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
